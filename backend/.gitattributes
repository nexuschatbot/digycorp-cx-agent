# Vendored binaries live in Git LFS: GitHub hard-rejects any file over 100MB,
# and these are artefacts that get REPLACED wholesale rather than edited, so
# plain git would store a full new copy of each on every refresh.
#
# app/assets/silero_vad.onnx is deliberately NOT here — it is 2.2MB, it predates
# this, and it is already in plain git history.
app/assets/multilingual-e5-small-int8.onnx filter=lfs diff=lfs merge=lfs -text
app/assets/multilingual-e5-small-tokenizer.json filter=lfs diff=lfs merge=lfs -text

# Elite's Jetour brochures — vendor artwork, 2-10MB each, replaced not edited.
content/brochures/pdf/*.pdf filter=lfs diff=lfs merge=lfs -text
