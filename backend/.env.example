# Elite Test Drive Booking AI Agent — backend environment
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# Model provider switch. true (the default) calls the Anthropic API directly;
# false routes the same Messages API surface (AD-A) through Azure AI Foundry.
# Only the credentials + model id for the selected provider are read.
USE_DIRECT_ANTHROPIC=true

# --- Direct Anthropic path (USE_DIRECT_ANTHROPIC=true) ---
# Server-side only, never exposed to the frontend. ANTHROPIC_MODEL is a MODEL ID.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Azure AI Foundry path (USE_DIRECT_ANTHROPIC=false) ---
# Server-side only. AZURE_FOUNDRY_RESOURCE builds
# https://<resource>.services.ai.azure.com/anthropic/. CLAUDE_MODEL is a
# DEPLOYMENT NAME, not a model id — the two namespaces are not interchangeable.
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_RESOURCE=egapi
CLAUDE_MODEL=claude-haiku-4-5

# Database. Default is local SQLite for dev. Swap to Postgres by setting a
# postgresql+psycopg:// (or postgresql://) URL — no code changes required.
DATABASE_URL=sqlite:///./elite_demo.db

# Write the cached prompt prefix at startup so the first customer reads the
# cache instead of creating it. Costs ONE live API call per boot — leave false
# in dev, set true on demo day (a QR-code wave otherwise all misses at once).
PREWARM_PROMPT_CACHE=false

# Slot lock time-to-live, in minutes. Abandoned conversations release inventory.
SLOT_LOCK_TTL_MINUTES=10

# How many rolling days ahead slots are generated/offered.
SLOT_HORIZON_DAYS=14

# --- Voice notes, INPUT ONLY (2026-07-21 scope override) ---
# Speech-to-text for customer voice notes. Aisha still replies in TEXT.
#
# A THIRD provider, and the only non-Anthropic one: Anthropic has no audio API,
# so this cannot reuse the switch at the top of this file. Azure Foundry was
# evaluated and has no transcription deployment (and `egapi` is East US, so it
# would not have helped residency either).
#
# OPTIONAL. Leave blank and everything else works exactly as before: the app
# boots, the text demo runs, and the transcribe endpoint answers
# {ok:false, reason:"stt_not_configured"} so the UI offers typing instead.
#
# ⚠️ PDPL: with this set, customer AUDIO LEAVES THE UAE to a US endpoint — the
# only place in this system that sends customer data out of region. On the D1
# checklist. Recordings are hard-deleted by "forget me" and expire after
# VOICE_RETENTION_HOURS regardless.
OPENAI_API_KEY=
STT_MODEL=gpt-4o-transcribe

# Recording limits. The browser caps duration too, but that is a UI affordance —
# these are the actual limits, enforced server-side.
VOICE_MAX_SECONDS=60
VOICE_MAX_BYTES=8388608

# How long a stored recording is kept before it is purged. 48h survives a
# rehearsal-to-demo overnight and is short enough to defend. "Forget me" does not
# wait for it. Sweeps opportunistically on each new recording; `python -m app.cli
# purge-voice` covers a box left idle for days.
VOICE_RETENTION_HOURS=48

# --- Read-aloud / TTS (2026-07-21 scope override) ---
# Server-generated speech for Aisha's replies, on request. Reuses OPENAI_API_KEY
# above. Unset, the frontend falls back to the browser's on-device voice — the
# feature degrades rather than disappearing.
#
# ⚠️ PDPL: HEAVIER THAN THE VOICE-NOTE PATH, and its own D1 entry. That one sent
# the customer's own audio; this sends AISHA'S REPLIES, which quote the customer
# back at them ("confirmed for Saturday, we'll text +971 50 555 0103") — a name,
# a mobile and a booking reference leaving the UAE. Clips are session-scoped,
# expire with VOICE_RETENTION_HOURS, and are erased by "forget me".
#
# gpt-4o-mini-tts over tts-1 because it accepts TTS_INSTRUCTIONS — it was audibly
# warmer in both languages at the same price (~$0.015/min).
TTS_MODEL=gpt-4o-mini-tts

# ONE VOICE PER LANGUAGE, chosen by ear. NOTE THE TRADE: two voices means Aisha
# SOUNDS LIKE A DIFFERENT PERSON when a customer switches language mid-chat,
# which is S-19. Set both the same to trade the other way.



LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=elite-aisha-demo
# Attach the CALL AUDIO (both voices, as WAV) to each voice-call LangSmith run
# so the audio-native voice evaluators can judge it. OFF by default and gated a
# second time by LANGSMITH_TRACING; a heavy PDPL surface (re-introduces stored
# audio, shipped to the US endpoint) — DEMO SANDBOX ONLY, never prod. See config.
CALL_TRACE_AUDIO=false
TTS_VOICE_EN=coral
TTS_VOICE_AR=shimmer

# Refuse to synthesise beyond this — a cost/latency guard, not a quality rule.
TTS_MAX_CHARS=4000

# --- Voice call (WS call channel — see CLAUDE.md AD-C amendment) -------------
# EXPLICITLY FLAGGED, unlike STT/TTS which activate on OPENAI_API_KEY alone: a
# call streams continuous live mic audio to a US endpoint for its whole
# duration (its own D1 PDPL entry) and costs ~$0.02-0.03/min in vendor audio.
# ⚠️ docker-compose backend.environment is an ALLOWLIST — CALL_* vars must be
# named there or values here never reach the container (the LangSmith lesson).
CALL_ENABLED=false
# Hard per-call ceiling (cost guard) — the gateway hangs up gracefully at it.
CALL_MAX_MINUTES=10
# Hang up after this much continuous silence (the call channel's idle ladder).
CALL_SILENCE_HANGUP_SECONDS=60
# Server-VAD end-of-turn threshold; client v0 detection mirrors it.
CALL_VAD_SILENCE_MS=900
# Per-utterance cap within a call (buffered for VoiceNote storage; the byte
# ceiling VOICE_MAX_BYTES applies unchanged).
CALL_UTTERANCE_MAX_SECONDS=60

# --- Retrieval -------------------------------------------------------------
# Cache for the vector index and its chunks only. Leave empty to build the index
# in process on boot (~14s once); nothing else changes.
REDIS_URL=

# Master switch for retrieval: the search_knowledge tool and the additive
# catalogue vector pass. Off by default until the baseline is re-measured.
RETRIEVAL_ENABLED=false
