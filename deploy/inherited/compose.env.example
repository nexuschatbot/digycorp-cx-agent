# Elite Test Drive Booking — root env for docker-compose (AD-G).
# Copy to `.env` (never commit it) and fill in the values below. docker-compose
# interpolates these at `up` time; secrets are never baked into image layers.

# Anthropic Claude API key — server-side only, never exposed to the frontend.
# Required: `docker compose up` fails fast if this is unset.
ANTHROPIC_API_KEY=

# Speech-to-text for customer VOICE NOTES (2026-07-21 scope override). Aisha
# still replies in TEXT — there is no TTS and no voice channel.
#
# OPTIONAL, unlike the key above: compose interpolates it with `:-`, so the stack
# starts without it and the text demo is unaffected. Left blank, the transcribe
# endpoint answers {"ok": false, "reason": "stt_not_configured"} and the UI
# offers typing instead.
#
# ⚠️ The mic ALSO needs HTTPS — getUserMedia is blocked on plain HTTP except on
#    localhost, so phones pointed at http://<host-ip>:5173 cannot record no
#    matter what this is set to. See DOCKER.md.
# ⚠️ PDPL: with this set, customer audio leaves the UAE to a US endpoint. On the
#    D1 checklist. Recordings are erased by "forget me" and expire after 48h.
OPENAI_API_KEY=

# WhatsApp Cloud API (Meta Graph API) — real booking confirmation + T-2h reminder
# (2026-07-22). Server-side only, sandbox for now.
#
# OPTIONAL like OPENAI_API_KEY: unset/disabled, the dispatcher runs in SIMULATOR
# mode (rows still go `sent` with rendered text) and nothing leaves the box.
#
# WHATSAPP_PHONE_NUMBER_ID and WHATSAPP_ACCESS_TOKEN come from the Meta app's
# WhatsApp > API Setup page (the token there is TEMPORARY — 24h). Set
# NOTIFY_DISPATCH_ENABLED=true to actually send.
#
# ⚠️ D1 PDPL: customer name/mobile/ref leave the region to a Meta endpoint.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# WhatsApp INBOUND handoff (2026-07-22). A customer WhatsApps "change my booking";
# we identify them, reply with a one-time link, and opening it drops them into the
# web chat already identified. Needs a PUBLIC HTTPS webhook (the deploy's FQDN)
# configured in Meta > WhatsApp > Configuration.
#
# OPTIONAL: with INBOUND_ENABLED=false the webhook accepts nothing and mints
# nothing, so leaving these blank is safe.
WHATSAPP_INBOUND_ENABLED=false
# A made-up password that MUST match the one typed into the Meta dashboard.
WHATSAPP_VERIFY_TOKEN=
# Meta > App Settings > Basic > App Secret. Verifies inbound requests really came
# from Meta (X-Hub-Signature-256). Blank = signature check SKIPPED (dev only).
WHATSAPP_APP_SECRET=
# The public origin the handoff link points at — the DEPLOYED FQDN, e.g.
# https://elite-demo.uaenorth.cloudapp.azure.com (no trailing slash). REQUIRED
# whenever WHATSAPP_INBOUND_ENABLED=true; an empty value makes the links break.
PUBLIC_WEB_BASE_URL=

# Turns on the in-process reminder clock (AD-F) that sends due rows. Off by
# default so tests/plain dev never auto-dispatch; the demo sets it true.
NOTIFY_DISPATCH_ENABLED=false
NOTIFY_POLL_SECONDS=15

# Relax the +971-only mobile rule so an international test number (e.g. a
# Pakistani +92) can be used in the sandbox. Set false for the demo.
STRICT_UAE_MOBILE=true

# Write the cached prompt prefix once at boot, so the first customer of a
# restart reads the cache instead of paying to write it (ONE live API call per
# restart). Measured on a real booking the prefix is ~14.8k tokens and 46% of
# the bill. Off by default because it spends money at import time, which a test
# run or a cold clone should never do; the demo turns it on.
PREWARM_PROMPT_CACHE=false

# --- Optional overrides -----------------------------------------------------
# The backend's DATABASE_URL is set to the postgres service inside
# docker-compose.yml and does not need to be defined here. It is documented for
# reference only:
#   DATABASE_URL=postgresql+psycopg://elite:elite@postgres:5432/elite
#
# For local (non-Docker) dev the backend defaults to SQLite via its own
# elite-group-backend/.env — see elite-group-backend/.env.example.

# --- LangSmith tracing (optional) --------------------------------------------
# Agent observability for the deployed demo: one trace per chat turn, showing
# the graph's agent/tools nodes and the model call inside them. Optional like
# OPENAI_API_KEY — unset, the app boots and runs exactly as before.
#
# ⚠️ TRACES CARRY THE WHOLE CONVERSATION — customer name, mobile, doorstep
# address, booking ref — to a US endpoint, and "forget me" (rule 12) CANNOT
# reach them: erasure clears our DB and checkpoint, not a third-party trace
# store. Its own D1 PDPL checklist entry. Set the two HIDE flags below to keep
# the timings, structure, token counts and errors while dropping the text.
#
# BELONGS IN THIS ROOT .env ONLY. Do NOT copy into elite-group-backend/.env —
# that is the file pytest loads, and a test run must never export to a live
# endpoint (see the offline-by-construction rule in CLAUDE.md).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=elite_group_test_drive_demo
# Blank = US (api.smith.langchain.com). eu.api.smith.langchain.com needs an
# EU-region key — a key only works in the region its workspace was created in.
LANGSMITH_ENDPOINT=
# Content redaction, no code required. true = keep the trace shape, drop the text.
# LANGSMITH_HIDE_INPUTS=true
# LANGSMITH_HIDE_OUTPUTS=true
