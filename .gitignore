# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
dist/
.vite/
npm-debug.log*

# Environment / secrets — never commit these
.env
.env.*
!.env.example

# Editors / OS
.DS_Store
.idea/
.vscode/

# Local dev databases. elite_demo.db is seeded from seed/ (`python -m seed.*`
# plus `python -m app.cli generate-slots`), and agent_checkpoints.db holds live
# conversation state — both are regenerable and both carry PII once anyone has
# talked to the agent.
*.db
*.db-shm
*.db-wal

# Test-only embedding cache (backend/tests/conftest.py::_memoise_embeddings).
# Shared across xdist workers so the 228-chunk corpus is embedded once per
# machine rather than once per worker. Keyed on the corpus text, so it cannot
# go stale; delete it and one run is slow.
backend/.embed-cache/
