# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
dist/
.vite/
npm-debug.log*

# Environment / secrets — never commit these
.env
.env.*
!.env.example

# Editors / OS
.DS_Store
.idea/
.vscode/

# Local dev databases. elite_demo.db is seeded from seed/ (`python -m seed.*`
# plus `python -m app.cli generate-slots`), and agent_checkpoints.db holds live
# conversation state — both are regenerable and both carry PII once anyone has
# talked to the agent.
*.db
*.db-shm
*.db-wal
